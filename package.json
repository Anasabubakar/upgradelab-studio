{
  "name": "upgradelab-studio",
  "version": "0.1.1",
  "private": true,
  "description": "Static viewer for UpgradeLab migration-rehearsal reports: invariants with evidence, executed-operation timeline, broken-versus-corrected comparison.",
  "license": "MIT",
  "author": "Anas Abubakar",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-validator.mjs --check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vendor": "node scripts/vendor-runner.mjs",
    "gen": "node scripts/gen-validator.mjs",
    "check:gen": "node scripts/gen-validator.mjs --check"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
